{{ 'section-product-ingredients.css' | asset_url | stylesheet_tag }}
{{ 'component-modal.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }} {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .section-{{ section.id }} .product-ingredients__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .product-ingredients__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }} .product-ingredients__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .section-{{ section.id }} .product-ingredients__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    padding: 2rem;
    background: rgb(var(--color-background));
    border-radius: var(--card-corner-radius);
    box-shadow: var(--card-shadow);
    transition: box-shadow var(--duration-short) ease;
  }

  .section-{{ section.id }} .product-ingredients__item:hover {
    box-shadow: var(--card-shadow-hover);
  }

  .section-{{ section.id }} .product-ingredients__media,
  .section-{{ section.id }} .product-ingredients__modal-media {
    width: 15rem;
    height: 15rem;
    margin-bottom: 2rem;
    border-radius: 50%;
    overflow: hidden;
  }

  .section-{{ section.id }} .product-ingredients__modal-media {
    width: 20rem;
    height: 20rem;
    margin: 3rem auto;
  }

  .section-{{ section.id }} .product-ingredients__media img,
  .section-{{ section.id }} .product-ingredients__modal-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-long) ease;
  }

  .section-{{ section.id }} .product-ingredients__item:hover .product-ingredients__media img {
    transform: scale(1.1);
  }

  .section-{{ section.id }} .product-ingredients__title {
    margin: 0 0 1rem;
    text-transform: uppercase;
    font-size: calc(var(--font-heading-scale) * 1.6rem);
  }

  .section-{{ section.id }} .product-ingredients__text {
    margin: 0 0 2rem;
    font-size: 1.4rem;
    line-height: 1.6;
  }

  .section-{{ section.id }} .product-ingredients__button {
    margin-top: auto;
    min-width: 12rem;
  }

  .section-{{ section.id }} .product-ingredients__modal-content {
    padding: 0 3rem 3rem;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .product-ingredients__modal-content {
      padding: 0 2rem 2rem;
    }

    .section-{{ section.id }} .product-ingredients__modal-media {
      width: 15rem;
      height: 15rem;
      margin: 2rem auto;
    }
  }

  .section-{{ section.id }} .product-ingredients__modal-title {
    margin: 0 0 2rem;
    text-transform: uppercase;
    font-size: calc(var(--font-heading-scale) * 2.4rem);
    text-align: center;
  }

  .section-{{ section.id }} .product-ingredients__modal-text {
    margin: 0 0 2rem;
    font-size: 1.6rem;
    line-height: 1.6;
  }

  .section-{{ section.id }} .product-ingredients__modal-text:last-child {
    margin-bottom: 0;
  }
{%- endstyle -%}

<div class="product-ingredients page-width section-{{ section.id }}">
  {%- assign ingredients = product.metaobjects.product_ingredient -%}
  
  {%- if ingredients != blank -%}
    <ul class="product-ingredients__grid">
      {%- for ingredient in ingredients -%}
        {%- if ingredient.enable.value == true -%}
          <li class="grid__item">
            <div class="product-ingredients__item">
              {%- if ingredient.image.value != blank -%}
                <div class="product-ingredients__media">
                  <img
                    srcset="{{ ingredient.image.value | image_url: width: 165 }} 165w,
                            {{ ingredient.image.value | image_url: width: 360 }} 360w,
                            {{ ingredient.image.value | image_url: width: 535 }} 535w"
                    src="{{ ingredient.image.value | image_url: width: 360 }}"
                    sizes="(min-width: 990px) 535px, (min-width: 750px) 360px, 165px"
                    alt="{{ ingredient.display_name.value | default: ingredient.name.value | escape }}"
                    width="{{ ingredient.image.value.width }}"
                    height="{{ ingredient.image.value.height }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}

              <div class="product-ingredients__content">
                <h3 class="product-ingredients__title h4">
                  {{ ingredient.display_name.value | default: ingredient.name.value | upcase }}
                </h3>
                
                {%- if ingredient.brief_description.value != blank -%}
                  <div class="product-ingredients__text rte">
                    {{ ingredient.brief_description.value }}
                  </div>
                {%- endif -%}

                {%- if ingredient.main_description.value != blank or ingredient.other_info.value != blank -%}
                  <button
                    type="button"
                    class="product-ingredients__button button button--tertiary"
                    aria-haspopup="dialog"
                    data-modal-opener="Ingredient-{{ ingredient.id }}"
                  >
                    {{ 'products.product.learn_more' | t }}
                  </button>

                  <modal-dialog
                    id="Ingredient-{{ ingredient.id }}"
                    class="product-ingredients__modal modal"
                  >
                    <div
                      role="dialog"
                      aria-modal="true"
                      class="modal__content"
                      tabindex="-1"
                    >
                      <button
                        type="button"
                        class="modal__close-button link"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        {% render 'icon-close' %}
                      </button>
                      <div class="modal__content-info">
                        {%- if ingredient.image.value != blank -%}
                          <div class="product-ingredients__modal-media">
                            <img
                              srcset="{{ ingredient.image.value | image_url: width: 550 }} 550w,
                                      {{ ingredient.image.value | image_url: width: 720 }} 720w,
                                      {{ ingredient.image.value | image_url: width: 990 }} 990w"
                              src="{{ ingredient.image.value | image_url: width: 550 }}"
                              sizes="(min-width: 990px) 990px, (min-width: 750px) 720px, 550px"
                              alt="{{ ingredient.display_name.value | default: ingredient.name.value | escape }}"
                              width="{{ ingredient.image.value.width }}"
                              height="{{ ingredient.image.value.height }}"
                              loading="lazy"
                            >
                          </div>
                        {%- endif -%}
                        
                        <div class="product-ingredients__modal-content">
                          <h2 class="product-ingredients__modal-title h3">
                            {{ ingredient.display_name.value | default: ingredient.name.value | upcase }}
                          </h2>
                          
                          {%- if ingredient.main_description.value != blank -%}
                            <div class="product-ingredients__modal-text rte">
                              {{ ingredient.main_description.value }}
                            </div>
                          {%- endif -%}

                          {%- if ingredient.other_info.value != blank -%}
                            <div class="product-ingredients__modal-text rte">
                              {{ ingredient.other_info.value }}
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </modal-dialog>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product Ingredients",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Product Ingredients"
    }
  ]
}
{% endschema %}
