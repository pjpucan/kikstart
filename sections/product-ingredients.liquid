{{ 'section-product-ingredients.css' | asset_url | stylesheet_tag }}
<script src="{{ 'modal-ingredients.js' | asset_url }}" defer="defer"></script>

<div class="product-ingredients page-width section-{{ section.id }}">
  {%- assign ingredients = product.metafields.custom.product_ingredient.value -%}
  
  {%- if ingredients != blank -%}

    <h2 class="main-title h2">Key Ingredients</h2>

    <ul class="product-ingredients__grid">
      {%- for ingredient in ingredients -%}
        {%- if ingredient.enable == true -%}
          <li class="grid__item">
            <div class="product-ingredients__item">
              {%- if ingredient.image != blank -%}
                <div class="product-ingredients__media">
                  <img
                    srcset="{{ ingredient.image | image_url: width: 165 }} 165w,
                            {{ ingredient.image | image_url: width: 360 }} 360w,
                            {{ ingredient.image | image_url: width: 535 }} 535w"
                    src="{{ ingredient.image | image_url: width: 360 }}"
                    sizes="(min-width: 990px) 535px, (min-width: 750px) 360px, 165px"
                    alt="{{ ingredient.name | escape }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}

              <div class="product-ingredients__content">
                <h3 class="product-ingredients__title h4">
                  {{ ingredient.name | upcase }}
                </h3>
                
                {%- if ingredient.brief_description != blank -%}
                  <div class="product-ingredients__text">
                    {{ ingredient.brief_description | metafield_tag }}
                  </div>
                {%- endif -%}

                {%- if ingredient.main_description != blank or ingredient.other_info != blank -%}
                  <button
                    type="button"
                    class="product-ingredients__button button button--tertiary"
                    aria-haspopup="dialog"
                    data-modal-opener="Ingredient-{{ forloop.index }}"
                  >
                    {{ 'products.product.learn_more' | t | default: 'Learn More' }}
                  </button>

                  <div
                    id="Ingredient-{{ forloop.index }}"
                    class="product-ingredients__modal modal"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="ModalTitle-{{ forloop.index }}"
                  >
                    <div class="modal__content">
                      <button
                        type="button"
                        class="modal__close-button"
                        aria-label="{{ 'accessibility.close' | t }}"
                        data-modal-close
                      >
                        {% render 'icon-close' %}
                      </button>

                      <div class="modal__content-info">
                        <div class="modal__content-media">
                          {%- if ingredient.image != blank -%}
                            <div class="featured-image">
                              <img
                                srcset="{{ ingredient.image | image_url: width: 550 }} 550w,
                                        {{ ingredient.image | image_url: width: 720 }} 720w,
                                        {{ ingredient.image | image_url: width: 990 }} 990w"
                                src="{{ ingredient.image | image_url: width: 550 }}"
                                sizes="(min-width: 990px) 990px, (min-width: 750px) 720px, 550px"
                                alt="{{ ingredient.name | escape }}"
                                loading="lazy"
                              >
                            </div>
                          {%- endif -%}

                          <div class="title-info">
                            {%- if ingredient.name != blank -%}
                            <h2 id="ModalTitle-{{ forloop.index }}" class="product-ingredients__modal-title h3">
                              {{ ingredient.name | upcase }}
                            </h2>
                            {%- endif -%}
                            
                            {%- if ingredient.other_info != blank -%}
                              <div class="modal-info rte">
                                {{ ingredient.other_info | metafield_tag }}
                              </div>
                            {%- endif -%}
                          </div> <!-- title-info -->
                        </div> <!-- modal-media -->
                        
                        <div class="product-ingredients__modal-content">
                          {%- if ingredient.main_description != blank -%}
                            <p class="product-ingredients__modal-description rte">
                              {{ ingredient.main_description | metafield_tag }}
                            </p>
                          {%- endif -%}
                    
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product Ingredients",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Product Ingredients"
    }
  ]
}
{% endschema %}
